# Copy this file to .env and fill in your actual values.
# .env is gitignored; never commit real secrets.

# --- Frontend (Vite) — REQUIRED to run the app ----------------------------
VITE_SUPABASE_PROJECT_ID="your-supabase-project-id"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"

# --- Local scripts only (optional) ----------------------------------------
# Edge-function runtime secrets must be set via:
#   supabase secrets set GEMINI_API_KEY=...
# The values below are only needed for local scripts (e.g. scripts/*.py).
GEMINI_API_KEY=""
INGEST_SHARED_SECRET=""

# --- Islamic research edge-function secrets (set via `supabase secrets set`) -
# Required by supabase/functions/islamic-api-fetch (Sunnah.com lane). If unset,
# the Sunnah.com source is silently skipped and a console warning is logged.
# Obtain at https://sunnah.com/developers
SUNNAH_API_KEY=""
# Required by supabase/functions/vector-search and islamic-search for the
# Lovable AI gateway (embeddings + Gemini-2.5-Flash).
LOVABLE_API_KEY=""
