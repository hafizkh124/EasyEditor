# Copy this file to .env and fill in your actual values.
# .env is gitignored; never commit real secrets.

# --- Frontend (Vite) — REQUIRED to run the app ----------------------------
VITE_SUPABASE_PROJECT_ID="your-supabase-project-id"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"

# M2 Workspace Shell feature flag (set to "false" to revert to M1 standalone pages)
VITE_WORKSPACE_SHELL="true"

# M3 feature flags. Each pillar ships independently; set any to "false" to fall
# back to the M2 behaviour for that pillar alone.
#   TASK_LIBRARY  — AI Task Library, custom tasks, Tasks + Trust workbench tabs
#   EDITOR_MENUS  — bubble menu, slash commands, mobile task sheet
#   TASK_CHUNKING — long-document chunked runs (progress, cancel, cost dialog)
VITE_TASK_LIBRARY="true"
VITE_EDITOR_MENUS="true"
VITE_TASK_CHUNKING="true"

# M4 feature flags. Set any to "false" to fall back to M3 behaviour for that
# pillar alone.
#   PERSONAL_CORPUS  — uploading books to the Library, ingest, personal sources
#   KNOWLEDGE_GRAPH  — entity extraction, the Library "Graph" tab
#   RECIPES          — multi-step recipe pipelines, the Library "Recipes" tab
#   ANNOTATIONS      — margin notes on the document
# NOTE: edge functions cannot read these. `refine-text` always fuses a personal
# corpus channel into citations — with PERSONAL_CORPUS off nothing can be
# uploaded, so that channel has no rows to return and results are unchanged.
VITE_PERSONAL_CORPUS="true"
VITE_KNOWLEDGE_GRAPH="true"
VITE_RECIPES="true"
VITE_ANNOTATIONS="true"

# M5 desktop flag. Gates the offline voice engines (Whisper STT, Piper TTS,
# edge-tts) and, with them, whether Transcribe and Speak appear in the Electron
# build at all. Defaults to "true" for desktop builds and "false" for web (see
# the `define` block in vite.config.ts); set it here only to override that.
# Web is unaffected — there Transcribe and Speak always use the cloud path.
VITE_LOCAL_VOICE="true"

# --- Local scripts only (optional) ----------------------------------------
# Edge-function runtime secrets must be set via:
#   supabase secrets set GEMINI_API_KEY=...
# The values below are only needed for local scripts (e.g. scripts/*.py).
GEMINI_API_KEY=""
INGEST_SHARED_SECRET=""

# NOTE: edge-function runtime secrets (LOVABLE_API_KEY, SUNNAH_API_KEY,
# HADITH_API_KEY, etc.) are managed inside the Lovable platform, NOT here.
# This file is only for local Python scripts under D:\EEData\scripts.
