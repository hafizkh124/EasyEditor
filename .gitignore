# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
bun.lock
bun.lockb

node_modules
dist
dist-electron
release
dist-ssr
*.local

# The bare `dist` rule above matches a directory named `dist` at ANY depth, so
# it also swallowed the *vendored* shamela-mcp build — which is source we ship,
# not build output we regenerate. Without it committed, the Lovable production
# build cannot package the local bridge zip and the download button silently
# never appears. Re-included deliberately; the directory has to be un-ignored
# before the file can be, since git will not descend into an excluded directory.
!tools/shamela-bridge/vendor/shamela-mcp/dist/
!tools/shamela-bridge/vendor/shamela-mcp/dist/index.js

# Environment variables - NEVER commit these
.env
.env.local
.env.development
.env.production
.env.staging

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Python
__pycache__/
*.pyc

# Local Data files (MDB databases & CSV dumps ingested into Supabase)
data/
*.dat
*.csv

# Build info & stats
*.tsbuildinfo
stats.html

# Generated at build time by scripts/generate-version.mjs (npm prebuild), so a
# tracked copy only ever produces phantom diffs carrying the last builder's
# commit hash.
public/app-version.json
public/downloads/shamela-bridge.zip
public/downloads/shamela-bridge.json

# Built by scripts/build-shamela-helper.mjs. The jar itself IS committed
# (SPEC-M5 R26 — an ordinary build must not need a JDK); only the staging copy
# that electron-builder packages is regenerated.
resources/bin/
electron/shamela/java/build/

# Temp probe scripts & extracted app dumps (agent scratch)
scratch/

# Shamela bridge's session-pairing secret (tools/shamela-bridge/auth.mjs) —
# generated per machine on first run, must never be committed.
tools/shamela-bridge/.bridge-token.json
probeMaster.*


# Vitest coverage output (npm run test:coverage) — regenerated, never committed.
coverage/

# Playwright output (npm run test:e2e) — regenerated, never committed.
test-results/
playwright-report/

# Personal / business documents and per-machine Claude settings — keep local only.
# The repo is public; investment plans and contact details do not belong here.
docs/private/
docs/EXECUTIVE-SUMMARY-1PAGE-URDU.md
docs/PROPOSAL-INVESTMENT-FUNDING-URDU.md
.claude/settings.local.json
